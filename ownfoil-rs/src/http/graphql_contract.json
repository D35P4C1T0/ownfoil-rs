  {
    "name": "Mutation",
    "kind": "object",
    "description": "Library-domain writes: enqueue work, cancel work, edit title metadata.\n\nDeliberately narrow - settings, users and the keys upload stay on REST, being\nform-and-file shaped rather than graph shaped. Unlike the query side, a write a\nrole may not perform raises rather than returning null: a silently ignored write\nis not a partial result, it is a lie. All of these require admin.",
    "fields": [
      {
        "name": "enqueueTask",
        "type": "Task",
        "args": [
          {
            "name": "name",
            "type": "String!"
          },
          {
            "name": "input",
            "type": "String",
            "default": null
          }
        ],
        "description": "Enqueue any registered task. `input` is a JSON object string, because the\npayload shape differs per task name. Enqueuing a duplicate returns the\nexisting task rather than creating a second one."
      },
      {
        "name": "cancelTask",
        "type": "Boolean!",
        "args": [
          {
            "name": "id",
            "type": "ID!"
          }
        ],
        "description": "False when the task is unknown or already in a terminal state."
      },
      {
        "name": "dismissTask",
        "type": "Boolean!",
        "args": [
          {
            "name": "id",
            "type": "ID!"
          }
        ],
        "description": "Clear one failed task. Failed tasks are kept so a failure survives a page\nreload, so this is how a task queue gets tidied once its failures have been\nread. False when the task is unknown or has not failed - a running or queued\ntask is `cancelTask`'s job, not this one."
      },
      {
        "name": "purgeFailedTasks",
        "type": "Int!",
        "args": [],
        "description": "Clear every failed task at once, returning how many were removed. Zero when\nthere was nothing to clear, which is not an error."
      },
      {
        "name": "scanLibrary",
        "type": "Task",
        "args": [
          {
            "name": "path",
            "type": "String",
            "default": null
          }
        ],
        "description": "Scan one library, or every configured library when `path` is omitted. The\nall-libraries form returns the last task enqueued."
      },
      {
        "name": "compressFile",
        "type": "Task",
        "args": [
          {
            "name": "fileId",
            "type": "ID!"
          }
        ],
        "description": "Compress one file to NSZ/XCZ. Same guards as the REST endpoint."
      },
      {
        "name": "decompressFile",
        "type": "Task",
        "args": [
          {
            "name": "fileId",
            "type": "ID!"
          }
        ],
        "description": "Decompress one file back to NSP/XCI."
      },
      {
        "name": "verifyFile",
        "type": "Task",
        "args": [
          {
            "name": "fileId",
            "type": "ID!"
          }
        ],
        "description": "Re-verify one file at the configured depth. The stored verdicts are cleared\nfirst, so this re-checks a file that already has them rather than no-opping."
      },
      {
        "name": "setTitleOverride",
        "type": "Title",
        "args": [
          {
            "name": "titleId",
            "type": "ID!"
          },
          {
            "name": "record",
            "type": "String!"
          }
        ],
        "description": "Write user-authored metadata for a title, winning over the downloaded\ntitledb values field by field. `record` is a JSON object of the same shape the\nREST endpoint takes. Re-identification is enqueued, as there too."
      },
      {
        "name": "deleteTitleOverride",
        "type": "Boolean!",
        "args": [
          {
            "name": "titleId",
            "type": "ID!"
          }
        ],
        "description": "Drop the override, restoring the next metadata source down."
      }
    ]
  },
  {
    "name": "Query",
    "kind": "object",
    "description": "Read access to the library and the titledb catalogue.\n\nEvery query is role-gated rather than hidden: a role that may not read something\ngets an empty page or a null, not an error. `titles` and `apps` need shop access;\n`files`, `libraries`, `tasks` and the file-level figures in `stats` need admin.",
    "fields": [
      {
        "name": "title",
        "type": "Title",
        "args": [
          {
            "name": "titleId",
            "type": "ID!"
          }
        ],
        "description": "One title by id, whether it is owned or only in the catalogue. Null when no\ntitle carries that id. `ownership` is null for a catalogue-only title."
      },
      {
        "name": "titles",
        "type": "TitleConnection!",
        "args": [
          {
            "name": "owned",
            "type": "Boolean",
            "default": null
          },
          {
            "name": "filter",
            "type": "TitleFilter",
            "default": null
          },
          {
            "name": "search",
            "type": "String",
            "default": null
          },
          {
            "name": "orderBy",
            "type": "OrderBy",
            "default": null
          },
          {
            "name": "page",
            "type": "Int!",
            "default": 1
          },
          {
            "name": "pageSize",
            "type": "Int!",
            "default": 50
          }
        ],
        "description": "A page of titles, from the catalogue and the library together. Requires\nshop access; returns an empty page otherwise."
      },
      {
        "name": "apps",
        "type": "AppConnection!",
        "args": [
          {
            "name": "owned",
            "type": "Boolean",
            "default": null
          },
          {
            "name": "appType",
            "type": "[AppType!]",
            "default": null
          },
          {
            "name": "filter",
            "type": "AppFilter",
            "default": null
          },
          {
            "name": "upToDate",
            "type": "Boolean",
            "default": null
          },
          {
            "name": "complete",
            "type": "Boolean",
            "default": null
          },
          {
            "name": "search",
            "type": "String",
            "default": null
          },
          {
            "name": "orderBy",
            "type": "OrderBy",
            "default": null
          },
          {
            "name": "groupByAppId",
            "type": "Boolean!",
            "default": false
          },
          {
            "name": "page",
            "type": "Int!",
            "default": 1
          },
          {
            "name": "pageSize",
            "type": "Int!",
            "default": 100
          }
        ],
        "description": "A page of apps: base games, updates and DLC, owned or merely known.\nRequires shop access; returns an empty page otherwise.\n\n`groupByAppId` collapses an app id's versions into one item, so a page is\na page of distinct apps rather than of (app id, version) rows. The item is the\ngroup's highest-version row - a real app, not a blend of several - except for\n`owned`, which is group-level: true when any version is owned. `upToDate` and\n`complete` are title-level notions: `upToDate` asks the title's flag for BASE\napps and \"is the highest known version owned\" for the others, while `complete`\nonly ever matches BASE apps."
      },
      {
        "name": "files",
        "type": "FileConnection!",
        "args": [
          {
            "name": "filter",
            "type": "FileFilter",
            "default": null
          },
          {
            "name": "orderBy",
            "type": "OrderBy",
            "default": null
          },
          {
            "name": "page",
            "type": "Int!",
            "default": 1
          },
          {
            "name": "pageSize",
            "type": "Int!",
            "default": 100
          }
        ],
        "description": "A page of tracked files. Admin only - every other role gets an empty page,\nsince file paths are filesystem layout.\n\n`orderBy: {field: ADDED_AT, direction: DESC}` is the \"recently added\" view;\nSIZE and DOWNLOAD_COUNT sort the obvious way. A field this query has no column\nfor falls back to id order rather than erroring."
      },
      {
        "name": "app",
        "type": "App",
        "args": [
          {
            "name": "id",
            "type": "ID!"
          }
        ],
        "description": "One app by primary key, including an item returned by\n`apps(groupByAppId: true)` - a grouped item is the group's highest-version row,\nnot a composite, so its `id` resolves back to that same app."
      },
      {
        "name": "file",
        "type": "File",
        "args": [
          {
            "name": "id",
            "type": "ID!"
          }
        ],
        "description": "One file by primary key. Admin only - null for any other role, which is\nindistinguishable from the file not existing, deliberately."
      },
      {
        "name": "libraries",
        "type": "[Library!]!",
        "args": [],
        "description": "The configured library roots. Admin only; empty for any other role."
      },
      {
        "name": "tasks",
        "type": "[Task!]!",
        "args": [
          {
            "name": "status",
            "type": "TaskStatus",
            "default": null
          },
          {
            "name": "taskName",
            "type": "String",
            "default": null
          },
          {
            "name": "includeChildren",
            "type": "Boolean!",
            "default": false
          },
          {
            "name": "limit",
            "type": "Int!",
            "default": 50
          }
        ],
        "description": "Background jobs, newest first. Admin only; empty for any other role.\nTop-level only unless `includeChildren`. An unregistered `taskName` is an\nerror rather than an empty list, so a typo does not read as \"nothing has\nrun\"."
      },
      {
        "name": "task",
        "type": "Task",
        "args": [
          {
            "name": "id",
            "type": "ID!"
          }
        ],
        "description": "One task by id, with its children when selected. Admin only - null for any\nother role."
      },
      {
        "name": "workers",
        "type": "[Worker!]!",
        "args": [],
        "description": "The task worker pool, ordered by worker number, each with the task it is\nrunning now. Admin only; empty for any other role, and empty in a process that\ndoes not own the pool."
      },
      {
        "name": "stats",
        "type": "LibraryStats!",
        "args": [],
        "description": "Library-wide aggregates for dashboards. Every field is computed only when\nselected, so asking for one count does not pay for the others. File-level\nfigures are admin only and read zero for other roles."
      }
    ]
  }
]
