FROM alpine:3.22
RUN apk add --no-cache ca-certificates curl shadow su-exec \
    && mkdir -p /app/config /app/data /games
COPY dist/ownfoil-rs /usr/local/bin/ownfoil-rs
COPY docker/entrypoint.sh /usr/local/bin/ownfoil-entrypoint
RUN chmod 0755 /usr/local/bin/ownfoil-rs /usr/local/bin/ownfoil-entrypoint
ENV OWNFOIL_SETTINGS=/app/config/settings.yaml
EXPOSE 8465
VOLUME ["/app/config", "/app/data", "/games"]
STOPSIGNAL SIGINT
ENTRYPOINT ["ownfoil-entrypoint"]
CMD ["ownfoil-rs"]
